<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
    
    <vertical child-control-height='false'>
        <horizontal bg='panel-top' pad-left='10' pad-right='10' horizontal-fit='PreferredSize'>
            <text text='Settings' align='Center' font-size='10' />
        </horizontal>
        
        <horizontal>
            <vertical spacing='1' horizontal-fit='PreferredSize' pad='5'>
                <checkbox-setting id='enabled-checkbox' text='Enabled' value='ModEnabled' apply-on-change='true' bind-value='true' hover-hint='Enable Custom Notes.'/>
                <slider-setting id='size-slider' text='Note Scale' min='0.4' max='2' increment='0.05' value='NoteSize' apply-on-change='true' bind-value='true' hover-hint='Changes the scale of custom notes. Requires a non-default note to be used.'/>
                <checkbox-setting id='hmd-checkbox' text='HMD Only' value='HmdOnly' apply-on-change='true' bind-value='true' hover-hint='Only displays custom notes in the headset. A non-default camera such as Smooth Camera, Camera+, or Camera2 is required.'/>
                <checkbox-setting id='auto-checkbox' text='Auto Disable Custom Notes' value='AutoDisable' apply-on-change='true' bind-value='true' hover-hint='Automatically disable custom notes in situations where submission would normally be turned off, allowing submissions.' />
                <checkbox-setting id='DisableAprilFools' text='Disable April Fools Mode (Lame) (Boring)' value='DisableAprilFools' apply-on-change='true' bind-value='true' hover-hint='Disable the randomly sized notes from the Custom Notes April Fools joke.' />
            </vertical>
        </horizontal>
    </vertical>
    
</bg>